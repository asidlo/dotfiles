#!/usr/bin/env bash
# Run Git Credential Manager so its *browser* sign-in works over VS Code Remote.
#
# Why this wrapper exists
# -----------------------
# GCM will only use the system browser if it thinks a browser can be launched.
# On Linux that decision is much cruder than it sounds -- LinuxSessionManager
# delegates to PosixSessionManager, whose entire test is:
#
#     IsDesktopSession => DISPLAY is non-empty || WAYLAND_DISPLAY is non-empty
#
# A remote SSH box has neither (XDG_SESSION_TYPE=tty), so IsWebBrowserAvailable
# is false and `credential.msauthFlow = system` fails outright in
# EnsureCanUseSystemWebView with "System web view is not available without a way
# to start a browser." GCM's only built-in alternative is device code.
#
# But a browser *is* reachable here, it just isn't on this machine: VS Code sets
# BROWSER to <server>/bin/helpers/browser.sh, which forwards `--openExternal`
# over the CLI IPC socket and opens the URL on the client. VS Code also
# auto-forwards the loopback port MSAL listens on, so the OAuth redirect lands
# back here. Declaring a display is therefore true in the only sense GCM uses
# it: a browser can be started.
#
# So: resolve the client browser, and only then claim a display. Both are
# exported into this process alone, so nothing else on the box ever observes a
# DISPLAY that has no X server behind it.
#
# GCM finds the browser via BrowserUtils.TryGetLinuxShellExecuteHandler, which
# searches $PATH for xdg-open first. The xdg-open on this image execs $BROWSER,
# which is why BROWSER must be set rather than merely present in the VS Code
# terminal that happened to start git.
#
# Overrides: GCM_EXECUTABLE pins the GCM binary, GCM_REMOTE_DISPLAY the display
# value. Set either if this box grows a real X/Wayland session.

set -euo pipefail

# --- locate GCM ------------------------------------------------------------
# Never resolve by bare name: this wrapper is itself on $PATH and a rename
# could turn that into an exec loop.
gcm=""
for candidate in \
  "${GCM_EXECUTABLE:-}" \
  /usr/local/bin/git-credential-manager \
  /usr/bin/git-credential-manager \
  "$HOME/.dotnet/tools/git-credential-manager"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    gcm="$candidate"
    break
  fi
done

if [ -z "$gcm" ]; then
  echo "git-credential-manager-remote: git-credential-manager not found." >&2
  echo "git-credential-manager-remote: set GCM_EXECUTABLE to its path." >&2
  exit 1
fi

# --- point at the client's browser -----------------------------------------
# Prefer whatever VS Code already exported; fall back to the most recently
# installed server, newest first, so a stale build is never preferred.
if [ -z "${BROWSER:-}" ] || [ ! -x "${BROWSER:-}" ]; then
  browser=$(ls -1dt \
    "$HOME"/.vscode-server/cli/servers/*/server/bin/helpers/browser.sh \
    "$HOME"/.vscode-server/bin/*/bin/helpers/browser.sh \
    2>/dev/null | head -n 1 || true)
  if [ -n "$browser" ] && [ -x "$browser" ]; then
    export BROWSER="$browser"
  fi
fi

# browser.sh talks to the VS Code client over this socket. Outside a VS Code
# terminal (a plain ssh login, a git hook) it is unset, and opening the URL
# silently fails -- GCM redirects the handler's stdout/stderr, so the failure
# would never reach the user. Pick the newest live socket instead.
if [ -z "${VSCODE_IPC_HOOK_CLI:-}" ]; then
  sock=$(ls -1t /run/user/"$(id -u)"/vscode-ipc-*.sock 2>/dev/null | head -n 1 || true)
  if [ -n "$sock" ] && [ -S "$sock" ]; then
    export VSCODE_IPC_HOOK_CLI="$sock"
  fi
fi

# --- claim a display, but only if a browser really is reachable ------------
# Faking DISPLAY without a working launcher just trades a clear error for a
# hang: GCM would open a URL into a swallowed stdout and then wait for a
# redirect that nobody can trigger.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  if [ -n "${BROWSER:-}" ] && [ -x "${BROWSER:-}" ]; then
    export DISPLAY="${GCM_REMOTE_DISPLAY:-:0}"
  else
    echo "git-credential-manager-remote: no VS Code browser helper found;" >&2
    echo "git-credential-manager-remote: browser sign-in is unavailable." >&2
    echo "git-credential-manager-remote: open a VS Code terminal, or export BROWSER." >&2
  fi
fi

exec "$gcm" "$@"
